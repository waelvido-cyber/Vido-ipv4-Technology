# Copy this file to .env before starting Docker Compose.
# Use strong, unique values in production.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Optional VIDO Tutor integration
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Quick admin login (server-side only; never hardcode a public password)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
